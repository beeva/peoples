# Configuration for server.py (the Python data API).
# Copy this file to `.env` and fill in the secrets. server.py loads `.env`
# automatically at startup; real shell environment variables override it.
# `.env` is git-ignored — never commit real keys.

# --- MySQL (the store everything is served from) ---
# The database belongs to this project: `npm run dev` starts it, its data lives
# in db/data, its config is db/my.ini, and it listens on 3307. You never need to
# open the XAMPP control panel, and this server is entirely separate from the
# databases in your XAMPP install -- only the mysqld binary is shared.
#
# Where to find that binary: the folder containing bin/mysqld.exe. Leave blank
# and D:/xampp/mysql, C:/xampp/mysql and E:/xampp/mysql are tried in that order.
MYSQL_BASEDIR=
MYSQL_HOST=127.0.0.1
# 3307, not 3306, so this can run beside whatever XAMPP has on the standard port.
MYSQL_PORT=3307
MYSQL_USER=root
# The project's own root account, created on first run with no password.
MYSQL_PASSWORD=
MYSQL_DATABASE=email_scrapper
# The project's data directory. Blank = db/data next to this file. Point it
# somewhere else (a bigger disk, say) and the next start creates it there.
MYSQL_DATADIR=
# Tuning lives in db/my.ini; set these only to override it for one run.
MYSQL_BUFFER_POOL=
MYSQL_MAX_PACKET=
# Where `npm run db:export` writes .sql dumps (git-ignored).
MYSQL_BACKUP_DIR=

# --- Claude: message generation + country/gender enrichment ---
# Create a key at https://console.anthropic.com (rotate it if it ever leaks).
# Leave blank to disable AI features (generation + enrichment).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Outbound email (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail *app password* (16 chars): myaccount.google.com → Security →
# 2-Step Verification → App passwords. Leave blank to disable sending.
SMTP_PASSWORD=
MAIL_FROM=you@gmail.com
# Display name the recipient sees, and the name the email signs off with.
MAIL_FROM_NAME=Ephrem

# --- GitHub scraper ---
# A token is not strictly required, but without one search is 10 requests/min
# and the API 60/hour, which makes a real run impractical. Create a classic or
# fine-grained token at https://github.com/settings/tokens — no scopes needed,
# it only reads public data.
GITHUB_TOKEN=

# --- Contact enrichment (infer country + gender via Claude) ---
ENRICH=1            # set to 0 to disable
ENRICH_WORKERS=3    # background inference concurrency
