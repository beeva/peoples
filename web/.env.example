# Configuration for the Next.js app. Copy to `web/.env.local` for local
# development, or set these as environment variables on the host (Vercel,
# Cloudflare Pages, Netlify). `web/.env.local` is git-ignored.
#
# None of these is NEXT_PUBLIC_, and none of them should be. Every call to the
# data server is made from the Next.js server -- server components and the
# route handlers in app/api -- never from the browser, so nothing here needs to
# reach the client, and a NEXT_PUBLIC_ name would inline it into the bundle for
# everyone to read.

# Where the Python data server is. Defaults to the local one.
API_BASE_URL=http://127.0.0.1:8000

# Must match API_TOKEN in the data server's environment. Blank locally, where
# the server binds loopback and does not check.
API_TOKEN=

# HTTP Basic auth over the whole app (web/middleware.ts). Both blank disables
# it, which is right for localhost. Set both on any deployment: this directory
# holds personal data for thousands of people who did not opt in to being in it.
UI_USER=
UI_PASS=
